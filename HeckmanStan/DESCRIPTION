Package: HeckmanStan
Type: Package
Title: Heckman Selection Models Based on Bayesian Analysis
Version: 1.0.0
Authors@R: c(
  person("Heeju", "Lim", email = "heeju.lim@uconn.edu", role = c("aut", "cre")),
  person("Victor E.", "Lachos", email = "elachoso27@gmail.com", role = c("aut")),
